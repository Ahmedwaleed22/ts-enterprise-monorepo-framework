# Database
#
# The migration and seeder layer is dialect-agnostic: pick a connection here and
# the same migrations and seeders run unchanged.
#
# Supported values for DB_CONNECTION: sqlite, postgres, mysql

# --- sqlite (default; needs no server and no extra dependency) ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# --- postgres (requires: pnpm add pg @types/pg) ---
# DB_CONNECTION=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=app
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSL=false

# --- mysql (requires: pnpm add mysql2) ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=app
# DB_USERNAME=root
# DB_PASSWORD=

# A single connection string works too, and implies the dialect:
# DATABASE_URL=postgres://postgres:secret@127.0.0.1:5432/app
# DATABASE_URL=mysql://root:secret@127.0.0.1:3306/app
# DATABASE_URL=file:database/database.sqlite
