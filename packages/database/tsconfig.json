{
  // Tooling config (editor, eslint's projectService, vitest). Covers tests too,
  // so type-aware lint rules can resolve them. Emitting is tsconfig.build.json's
  // job — this one inherits `noEmit` from the root config.
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
